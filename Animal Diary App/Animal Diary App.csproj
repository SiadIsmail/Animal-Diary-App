<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="keystore.props" Condition="Exists('keystore.props')" />

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Animal_Diary_App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- MauiEnableXamlCBindingWithSourceCompilation is deliberately left OFF.
		     Turning it on compiles bindings that set Source explicitly, but this app's
		     list-item commands reach the page VM through
		     {RelativeSource AncestorType={x:Type ContentPage}} + Path=BindingContext.…,
		     and ContentPage.BindingContext is typed `object`, so those paths cannot be
		     resolved at compile time. The flag turns ~35 harmless "not compiled" notes
		     (XC0025) into ~23 misleading "property not found" warnings that would mask
		     real ones. Those bindings stay on the reflection path, as they are today. -->


		<!-- Display name -->
		<ApplicationTitle>Felova</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.felova.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.4.1</ApplicationDisplayVersion>
		<ApplicationVersion>24</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<!-- minSdk 24 (Android 7.0): required by the RevenueCat SDK and its Play Billing /
		     AndroidX dependencies, which declare minSdk 23-24 and fail the manifest merge
		     below 24. Raised from 21; drops pre-7.0 devices (a negligible share by 2026). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- ══ Warnings ══════════════════════════════════════════════════════════════
	     A clean build is 0 errors and 0 warnings, so anything that appears is new and
	     worth looking at. That only works if the permanently-accepted noise is
	     suppressed HERE, with a reason each, instead of being carried as a number in a
	     doc that nobody can verify. Never add a code below without a comment saying why
	     it can never be fixed — "it's noisy" is not a reason.

	     Deliberately NOT suppressed anywhere: CS4014 (un-awaited Task), which
	     .editorconfig promotes to an error — fire-and-forget goes through .Forget().
	-->
	<PropertyGroup>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- Suppressed, each permanently and for a stated reason:
		       CS0618 — .NET 10 deprecated the non-Async animation + dialog helpers
		                (FadeTo/TranslateTo/DisplayAlert/DisplayActionSheet) in favour of
		                the *Async forms. ~85 call sites; the migration is real debt,
		                tracked in AI/known-constraints.md, not something to fix under a
		                build flag.
		       CS0162 — AnalyticsConfig.Enabled / CloudConfig.Enabled / BillingConfig.Enabled
		                are consts, so the null-service branch of each boundary is
		                unreachable in any given build. That is the point of a
		                compile-time feature switch.
		     Keep this a single-line semicolon list (the documented NoWarn format);
		     comments inside the element leak whitespace into the value. -->
		<NoWarn>$(NoWarn);CS0618;CS0162</NoWarn>

		<!-- Restore-time advisories that stay VISIBLE but must not fail the build:
		       NU1608 — Xamarin.AndroidX transitive version constraint.
		       NU1903 — CVE-2025-6965, present in every SQLitePCLRaw release to date
		                (see the package comment below). Re-check whenever SQLitePCLRaw
		                ships a build bundling SQLite >= 3.50.2.
		     WarningsNotAsErrors is the property NuGet documents for this, used together
		     with TreatWarningsAsErrors above. -->
		<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1608;NU1903</WarningsNotAsErrors>
	</PropertyGroup>

	<!-- Android target API level.
	     Google Play requires apps to target Android 16 (API 36) or higher. Per the
	     .NET docs, .NET 9 caps out at API 35 — API 36 is only supported on .NET 10,
	     where net10.0-android defaults to API 36. That is why this whole project was
	     migrated from net9.0-* to net10.0-* rather than trying to bolt API 36 onto a
	     .NET 9 runtime (an unsupported net9-runtime + net10-Android-SDK mix).
	     AndroidTargetSdkVersion is kept explicit as documentation; on net10.0-android
	     it simply matches the default rather than overriding anything. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png"/>

		<!-- Splash Screen -->
		<!-- felova_splash.svg is Resources\Images\felova_rockpool_logo.svg with its two
		     <text> runs converted to outlines. Resizetizer renders SVG text using fonts
		     installed on the BUILD MACHINE, and Fraunces / Plus Jakarta Sans ship inside
		     the app rather than being installed — so the live wordmark would fall back to
		     a substitute font and vary per machine. Outlines make it deterministic.
		     Re-generate it if the logo changes; don't hand-edit the path data.
		     Colour matches LoadingPage's background so the handoff is seamless. -->
		<MauiSplashScreen Include="Resources\Splash\felova_splash.svg" Color="#C4E6E3" BaseSize="190,170" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- Referenced unconditionally on purpose. MauiProgram only calls AddDebug()
		     inside #if DEBUG, so it is dead weight in Release — but a PackageReference
		     conditioned on $(Configuration) is worse: NuGet restores ONE configuration
		     and writes a single project.assets.json, so a config-dependent package graph
		     desyncs restore from build and surfaces as NETSDK1047 ("assets file has no
		     target for …"). Not worth it for one small logging package. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="Plugin.LocalNotification" Version="12.0.2" />

		<!-- Vet-report PDF export. PDFsharp + MigraDoc are pure-managed (MIT) — no native
		     libraries, so nothing here contributes to the 16 KB page-alignment problem.
		     They REPLACED QuestPDF, which was pinned to 2023.12.6 (its last Android-capable
		     release) and in turn pinned SkiaSharp to the 2.88.x line whose libSkiaSharp.so /
		     libHarfBuzzSharp.so ship 4 KB-aligned and crash on 16 KB-page devices. See
		     Data/Services/Reports for the MigraDoc document builder. -->
		<PackageReference Include="PDFsharp-MigraDoc" Version="6.2.0" />

		<!-- SkiaSharp is kept ONLY for the report's chart rasters (see ChartRenderer /
		     ObservationChartRenderer): the charts render to an offscreen SKSurface → PNG
		     that MigraDoc embeds. 3.116.1+ is the first line with 16 KB-aligned native
		     binaries (2.88.x never was); 3.119.2 is the current stable 3.x. MIT-licensed,
		     no revenue threshold. HarfBuzzSharp is gone with QuestPDF — the chart labels
		     need no text shaping, so libHarfBuzzSharp.so no longer ships. -->
		<PackageReference Include="SkiaSharp" Version="3.119.2" />

		<!-- e_sqlite3 16 KB alignment: bundle_green 2.1.11 is the newest SQLitePCLRaw
		     (16 KB-aligned since 2.1.10), overriding the 4 KB 2.1.2 that sqlite-net-pcl
		     pulls transitively.
		     NOTE: restore reports NU1903 (CVE-2025-6965, SQLite < 3.50.2 aggregate memory
		     corruption). It affects EVERY SQLitePCLRaw release to date (incl. 2.1.11) — no
		     patched version exists yet, and the old 2.1.2 was equally affected. Exposure is
		     low: all SQL is app-authored against a local DB (no untrusted SQL path).
		     Revisit when SQLitePCLRaw ships a build bundling SQLite >= 3.50.2. -->
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
	</ItemGroup>

	<!-- RevenueCat (in-app subscriptions). Community MAUI binding that bundles the
	     native RevenueCat SDK; mobile stores only, so it is referenced on Android/iOS
	     alone. The Windows/macOS dev build never sees it (and registers the no-op
	     NullEntitlementService instead). v7.1.0 bundles native Android 10.1.2, which
	     supports the Test Store (test_) API key. -->
	<!-- AndroidX ExifInterface, for reading a captured photo's orientation tag
	     (PetPhotoService). Google's maintained reader, and the one their own docs point
	     at: the framework's android.media.ExifInterface is deprecated and handles fewer
	     format quirks, which matters because the tag is the only thing standing between
	     a camera shot and an avatar that arrives a quarter-turn wrong. Android-only —
	     iOS applies orientation on UIImage and needs none of this. -->
	<!-- Play Install Referrer, for creator-link attribution: Google Play preserves a
	     `referrer` value through an install and the app reads it once on first run.
	     Microsoft's binding (MIT) over com.android.installreferrer:installreferrer 2.2.
	     Android-only by nature — Apple's campaign tokens reach App Store Connect
	     analytics and are not readable by the app, so iOS gets the null source. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.ExifInterface" Version="1.4.2.3" />
		<PackageReference Include="Xamarin.Google.Android.InstallReferrer" Version="2.2.0.6" />
	</ItemGroup>

	<!-- Meta (Facebook) App Events, for ONE thing: reporting the install so a Meta
	     app-promotion campaign can attribute it. Android-only because the app does not ship
	     on the App Store yet and Meta's iOS SDK is a separate binding job; every other
	     platform registers NullAdAttributionService and does nothing.

	     A local binding project rather than a package, because no maintained NuGet binding
	     exists — Microsoft's Xamarin.Facebook.Android stopped at 11.2.0.1 in 2021 and the
	     native SDK is on 18.x. It stays a separate project so its ~400 unavoidable
	     generated-code warnings never reach this csproj's TreatWarningsAsErrors. The AAR
	     carries no .so of its own, so nothing here touches the 16 KB alignment constraint.

	     See Data/Services/Attribution/ for the seam, and AI/analytics.md for why this is
	     kept structurally separate from the anonymous PostHog pipeline. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ProjectReference Include="..\Felova.Meta.Binding\Felova.Meta.Binding.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PackageReference Include="Kebechet.Maui.RevenueCat.InAppBilling" Version="7.1.0" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(TargetFramework)' == 'net10.0-android'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>felova-upload.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>felova</AndroidSigningKeyAlias>
	</PropertyGroup>

</Project>
