<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="keystore.props" Condition="Exists('keystore.props')" />

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Animal_Diary_App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- MauiEnableXamlCBindingWithSourceCompilation is deliberately left OFF.
		     Turning it on compiles bindings that set Source explicitly, but this app's
		     list-item commands reach the page VM through
		     {RelativeSource AncestorType={x:Type ContentPage}} + Path=BindingContext.…,
		     and ContentPage.BindingContext is typed `object`, so those paths cannot be
		     resolved at compile time. The flag turns ~35 harmless "not compiled" notes
		     (XC0025) into ~23 misleading "property not found" warnings that would mask
		     real ones. Those bindings stay on the reflection path, as they are today. -->


		<!-- Display name -->
		<ApplicationTitle>Felova</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.felova.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.3.8</ApplicationDisplayVersion>
		<ApplicationVersion>17</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<!-- minSdk 24 (Android 7.0): required by the RevenueCat SDK and its Play Billing /
		     AndroidX dependencies, which declare minSdk 23-24 and fail the manifest merge
		     below 24. Raised from 21; drops pre-7.0 devices (a negligible share by 2026). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- ══ Warnings ══════════════════════════════════════════════════════════════
	     A clean build is 0 errors and 0 warnings, so anything that appears is new and
	     worth looking at. That only works if the permanently-accepted noise is
	     suppressed HERE, with a reason each, instead of being carried as a number in a
	     doc that nobody can verify. Never add a code below without a comment saying why
	     it can never be fixed — "it's noisy" is not a reason.

	     Deliberately NOT suppressed anywhere: CS4014 (un-awaited Task), which
	     .editorconfig promotes to an error — fire-and-forget goes through .Forget().
	-->
	<PropertyGroup>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>
			$(NoWarn);
			<!-- CS0618: .NET 10 deprecated the non-Async animation + dialog helpers
			     (FadeTo/TranslateTo/DisplayAlert/DisplayActionSheet) in favour of the
			     *Async forms. ~85 call sites across the pages; the migration is real
			     debt, tracked in AI/known-constraints.md, not something to fix under a
			     build flag. -->
			CS0618;
			<!-- CS0162: AnalyticsConfig.Enabled / CloudConfig.Enabled / BillingConfig.Enabled
			     are consts, so the null-service branch of each boundary is unreachable in
			     any given build. That is the point of a compile-time feature switch — the
			     dead branch is what makes flipping one line a complete change. -->
			CS0162
		</NoWarn>
		<!-- NU1608 (Xamarin.AndroidX version constraint) and NU1903 (CVE-2025-6965 in
		     every SQLitePCLRaw release to date — see the package comment below) are
		     restore-time, so they need MSBuildWarningsNotAsErrors rather than NoWarn:
		     they stay visible, they just don't fail the build. Re-check NU1903 whenever
		     SQLitePCLRaw ships a build bundling SQLite >= 3.50.2. -->
		<MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);NU1608;NU1903</MSBuildWarningsNotAsErrors>
		<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1608;NU1903</WarningsNotAsErrors>
	</PropertyGroup>

	<!-- Android target API level.
	     Google Play requires apps to target Android 16 (API 36) or higher. Per the
	     .NET docs, .NET 9 caps out at API 35 — API 36 is only supported on .NET 10,
	     where net10.0-android defaults to API 36. That is why this whole project was
	     migrated from net9.0-* to net10.0-* rather than trying to bolt API 36 onto a
	     .NET 9 runtime (an unsupported net9-runtime + net10-Android-SDK mix).
	     AndroidTargetSdkVersion is kept explicit as documentation; on net10.0-android
	     it simply matches the default rather than overriding anything. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png"/>

		<!-- Splash Screen -->
		<!-- felova_splash.svg is Resources\Images\felova_rockpool_logo.svg with its two
		     <text> runs converted to outlines. Resizetizer renders SVG text using fonts
		     installed on the BUILD MACHINE, and Fraunces / Plus Jakarta Sans ship inside
		     the app rather than being installed — so the live wordmark would fall back to
		     a substitute font and vary per machine. Outlines make it deterministic.
		     Re-generate it if the logo changes; don't hand-edit the path data.
		     Colour matches LoadingPage's background so the handoff is seamless. -->
		<MauiSplashScreen Include="Resources\Splash\felova_splash.svg" Color="#C4E6E3" BaseSize="190,170" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- Debug-only: MauiProgram registers the debug logger inside #if DEBUG, so
		     shipping the package in Release was dead weight in the app bundle. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0"
		                  Condition="'$(Configuration)' == 'Debug'" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<!-- Pinned to 2023.12.x on purpose: it is the LAST QuestPDF version that runs
		     on Android (2024.3+ replaced SkiaSharp with a custom native Skia layer that
		     ships no Android/iOS binaries). Community license: free while annual gross
		     revenue is under $1M USD — see VetReportService where it is declared. -->
		<PackageReference Include="QuestPDF" Version="2023.12.6" />
		<PackageReference Include="Plugin.LocalNotification" Version="12.0.2" />

		<!-- 16 KB page-size alignment (Google Play requirement for API 36 updates).
		     These native .so libraries arrive TRANSITIVELY — SkiaSharp/HarfBuzzSharp via
		     QuestPDF, e_sqlite3 via sqlite-net-pcl — and the versions those packages pull
		     (SkiaSharp 2.88.7, HarfBuzzSharp 7.3.0.1, SQLitePCLRaw 2.1.2) were built with
		     an old NDK that aligns to 4 KB, which crashes on 16 KB-page devices. These
		     explicit references override the transitive ones with NDK-r28 / 16 KB-aligned
		     builds. SkiaSharp stays on the 2.88.x line so QuestPDF 2023.12.6 (pinned above)
		     is unaffected.
		     bundle_green 2.1.11 is the newest SQLitePCLRaw (16 KB-aligned since 2.1.10).
		     NOTE: restore reports NU1903 (CVE-2025-6965, SQLite < 3.50.2 aggregate memory
		     corruption) against e_sqlite3. It affects EVERY SQLitePCLRaw release up to and
		     including 2.1.11 — there is no patched version yet, and the old 2.1.2 we shipped
		     before was equally affected — so 2.1.11 is simply the least-old option. Exposure
		     here is low: all SQL is app-authored against a local DB (no untrusted SQL path).
		     Revisit when SQLitePCLRaw ships a build bundling SQLite >= 3.50.2. -->
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="HarfBuzzSharp" Version="7.3.0.3" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
	</ItemGroup>

	<!-- RevenueCat (in-app subscriptions). Community MAUI binding that bundles the
	     native RevenueCat SDK; mobile stores only, so it is referenced on Android/iOS
	     alone. The Windows/macOS dev build never sees it (and registers the no-op
	     NullEntitlementService instead). v7.1.0 bundles native Android 10.1.2, which
	     supports the Test Store (test_) API key. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<PackageReference Include="Kebechet.Maui.RevenueCat.InAppBilling" Version="7.1.0" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(TargetFramework)' == 'net10.0-android'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>felova-upload.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>felova</AndroidSigningKeyAlias>
	</PropertyGroup>

</Project>
