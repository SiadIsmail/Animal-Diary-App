<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true">
		<!-- Meta SDK auto-initialization: off, all three flags.

		     The credentials live in code rather than here (see MetaAdsConfig and why), so
		     facebook-core's FacebookInitProvider — a ContentProvider that runs before any
		     app code and calls sdkInitialize unconditionally — already finds no app id and
		     gives up. These are the belt to that braces: if anyone ever does add the app id
		     to this file, the SDK still cannot start collecting before
		     MetaAdAttributionService has checked whether the owner allows it. That service
		     turns all three on at runtime once it has. Do not set any of them true here. -->
		<meta-data android:name="com.facebook.sdk.AutoInitEnabled" android:value="false" />
		<meta-data android:name="com.facebook.sdk.AutoLogAppEventsEnabled" android:value="false" />
		<meta-data android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled" android:value="false" />
	</application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<!-- No SCHEDULE_EXACT_ALARM: reminders use inexact allow-while-idle delivery so the
	     app needs only POST_NOTIFICATIONS (one prompt, no "Alarms & reminders" settings
	     detour) and carries no Play exact-alarm policy exposure. A reminder is not an
	     emergency, and the bounded-horizon re-arm covers the real reliability gap.
	     See AI/design-decisions.md -> "Reminders use inexact (allow-while-idle) alarms". -->
	<!-- Profile-photo capture. Library picking uses the system photo picker and needs
	     no storage permission; the FileProvider MediaPicker relies on is contributed
	     automatically by .NET MAUI Essentials. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<queries>
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
	</queries>
	<!-- The advertising ID (AD_ID) is COLLECTED, for one purpose: attributing an install to
	     a Meta ad campaign. facebook-core declares it (along with the four Privacy Sandbox
	     ACCESS_ADSERVICES_* permissions) and the merger brings it in; that is intended, so
	     there is deliberately no uses-permission line here to strip it.

	     This REVERSES an earlier decision, and the reversal is the point of this comment.
	     AD_ID used to be removed with tools:node="remove" — RevenueCat's transitive
	     Ads.Identifier dependency merged it in, nothing used it, and dropping it kept the
	     Play declaration honestly "No". That is no longer true. Do not restore the removal
	     while Meta attribution ships: the merger would silently drop the permission, the SDK
	     would find no advertising id on Android 13+, and installs would go unattributed with
	     nothing in the build to explain why.

	     Consequences that travel with this, and must stay in step:
	       • Play Data Safety declares the advertising ID as collected AND shared with a
	         third party for advertising. Both must be ticked.
	       • The privacy policy at felova.app/privacy has to say the same.
	       • The owner can switch it off in Settings (AdTrackingSettings); the SDK then never
	         initializes and no advertising id is read.
	     Analytics is unaffected and still never sees it — its identity is a random GUID
	     (AnalyticsIdentity.cs) and the two subsystems share no code. See AI/analytics.md. -->
</manifest>
