<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:Animal_Diary_App.Helpers"
             xmlns:loc="clr-namespace:Animal_Diary_App.Helpers"
             xmlns:view="clr-namespace:Animal_Diary_App.Data.View"
             xmlns:controls="clr-namespace:Animal_Diary_App.Data.View.Controls"
             xmlns:vms="clr-namespace:Animal_Diary_App.Data.ViewModels"
             x:DataType="vms:MainViewModel"
             x:Class="Animal_Diary_App.Data.View.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#C4E6E3">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter"/>

            <!-- Frosted glass card surface (matches Journal) -->
            <Style x:Key="GlassCard"
                   TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource Glass}"/>
                <Setter Property="Stroke"
                        Value="{StaticResource GlassLine}"/>
                <Setter Property="StrokeThickness"
                        Value="1"/>
                <Setter Property="StrokeShape"
                        Value="RoundRectangle 17,14,15,18"/>
                <Setter Property="Padding"
                        Value="16"/>
            </Style>

            <!-- Warm italic-serif section heading -->
            <!-- One range button in the look-back selector; the label and the
                 selected accent are set per-instance. Hoisted here from the retired
                 WeightChartView, which owned the only copy. -->
            <Style x:Key="RangeTab" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource InkTertiary}"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
                <Setter Property="Padding" Value="0,5"/>
            </Style>

            <Style x:Key="SerifHeading"
                   TargetType="Label">
                <Setter Property="FontFamily"
                        Value="{StaticResource FontSerifItalic}"/>
                <Setter Property="FontSize"
                        Value="17"/>
                <Setter Property="TextColor"
                        Value="{StaticResource Ink}"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Water background — bottom layer, spans the whole page -->
        <!-- Motion is driven by the page (OnAppearing / OnDisappearing) so only the
             visible tab ever animates. See WaterBackground.xaml.cs for why that is
             the page's job and not the control's. -->
        <controls:WaterBackground x:Name="Backdrop" Grid.RowSpan="2"/>

        <!-- ================= TODAY ================= -->
        <ScrollView Grid.Row="0">

            <VerticalStackLayout Padding="22,26,22,20"
                                 Spacing="22">

                <!-- 1 ── Header: greeting + handwritten aside + settings ── -->
                <Grid ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">

                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="1"
                                         VerticalOptions="Center">
                        <Label Text="{Binding MainPageVM.Greeting}"
                               FontFamily="{StaticResource FontSerif}"
                               FontSize="{StaticResource TypeH1}"
                               TextColor="{StaticResource Ink}"/>
                        <!-- rotating handwritten aside (set per load, Caveat) -->
                        <Label x:Name="AsideLabel"
                               FontFamily="{StaticResource FontHand}"
                               FontSize="18"
                               TextColor="{StaticResource TealDeep}"/>
                    </VerticalStackLayout>

                    <!-- Settings button -->
                    <Border Grid.Column="1"
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="{StaticResource Glass}"
                            Stroke="{StaticResource GlassLine}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20,19,19,20"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Settings">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SettingsVM.OpenSettingsCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="⚙️"
                               FontSize="17"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- 1b ── Reminders blocked notice ──
                     Shown only when reminders are set up AND the OS won't deliver
                     them (permission declined, or notifications switched off later).
                     States the fact and offers the one action that fixes it; no
                     alarm words, no guilt. Reassures that nothing is lost. -->
                <Border Style="{StaticResource GlassCard}"
                        IsVisible="{Binding MainPageVM.RemindersBlocked}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{loc:Translate Today_RemindersOffTitle}"
                               Style="{StaticResource SerifHeading}"/>
                        <Label Text="{loc:Translate Today_RemindersOffBody}"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="13"
                               TextColor="{StaticResource InkSecondary}"/>
                        <Label Text="{loc:Translate Today_RemindersOffAction}"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TealDeep}"
                               Margin="0,2,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding MainPageVM.OpenNotificationSettingsCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- 1c ── The visit that is near ──
                     The appointment lives quietly on Care and takes over Today only
                     when it is close: same slot and same GlassCard as the notice above,
                     visible only inside the last seven days.

                     No countdown, no urgency, and no colour change as it approaches —
                     a visit does not become more important on the Tuesday than it was
                     on the Friday, and pretending otherwise would be the app adding
                     alarm the owner did not ask for (AI/app-voice.md §8). -->
                <Border Style="{StaticResource GlassCard}"
                        IsVisible="{Binding MainPageVM.HasNearVisit}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MainPageVM.OpenAppointmentCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{Binding MainPageVM.NearVisitLine}"
                                   Style="{StaticResource SerifHeading}"/>
                            <Label Text="{loc:Translate Today_VisitSummaryReady}"
                                   FontFamily="{StaticResource FontSans}"
                                   FontSize="13"
                                   TextColor="{StaticResource InkSecondary}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="→"
                               FontSize="20" TextColor="{StaticResource TealDeep}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- 2 ── Active pet hero: precise care ring + avatar ── -->
                <VerticalStackLayout HorizontalOptions="Center"
                                     Spacing="3"
                                     Margin="0,6,0,0">

                    <Grid HorizontalOptions="Center"
                          WidthRequest="132"
                          HeightRequest="132">

                        <!-- Care-completion ring (DATA — precise, animated fill).
                             Progress = today's done/total from the same PendingEngine
                             snapshot the Journal's "Still to do" chips use. -->
                        <controls:ProgressRingView x:Name="CareRing"
                                                   WidthRequest="132"
                                                   HeightRequest="132"
                                                   Progress="{Binding MainPageVM.CareProgress}"
                                                   ProgressColor="{StaticResource Teal}"
                                                   TrackColor="{StaticResource TealLine}"
                                                   RingThickness="6"/>

                        <!-- Avatar — profile photo, or the type emoji fallback -->
                        <controls:PetAvatarView Diameter="108"
                                                FallbackFontSize="48"
                                                PhotoPath="{Binding MainPageVM.ActivePet.PhotoFullPath}"
                                                FallbackText="{Binding PetVM.ActivePetEmoji}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"/>
                    </Grid>

                    <!-- Pet name -->
                    <Label Text="{Binding MainPageVM.ActivePet.Name}"
                           FontFamily="{StaticResource FontSerif}"
                           FontSize="{StaticResource TypeDisplay}"
                           TextColor="{StaticResource Ink}"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"/>

                    <!-- Meta line: type · age · weight (DATA — precise) -->
                    <Label HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           FontFamily="{StaticResource FontSans}"
                           FontSize="13.5"
                           TextColor="{StaticResource InkSecondary}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span>
                                    <Span.Text>
                                        <MultiBinding Converter="{StaticResource PetTypeLocalizedConverter}">
                                            <Binding Path="MainPageVM.ActivePet.Type"/>
                                            <Binding Path="CurrentLanguage" Source="{x:Static loc:LocalizationManager.Instance}"/>
                                        </MultiBinding>
                                    </Span.Text>
                                </Span>
                                <Span Text=" · "/>
                                <Span Text="{Binding MainPageVM.ActivePet.AgeYears}"/>
                                <Span Text="{loc:Translate Common_YearsSeparator}"/>
                                <Span Text="{Binding MainPageVM.LatestWeight}"/>
                                <Span Text="{loc:Translate Common_KgSuffix}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>                    
                </VerticalStackLayout>

                <!-- 3 ── Next up: first pending med dose or care-plan tracker ── -->
                <Grid Margin="0,4,0,0">
                    <Border x:Name="NextMedCard"
                            Rotation="-1.2"
                            BackgroundColor="{StaticResource Glass}"
                            Stroke="{StaticResource GlassLine}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16,13,14,15"
                            Padding="15,14">
                        <Border.Shadow>
                            <Shadow Brush="#0D3A3C"
                                    Offset="0,6"
                                    Radius="18"
                                    Opacity="0.10"/>
                        </Border.Shadow>

                        <!-- contents counter-rotated so the readout stays level -->
                        <Grid Rotation="1.2"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14">

                            <Border WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="{StaticResource HoneyWarmTint}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    VerticalOptions="Center">
                                <Label x:Name="NextMedIcon"
                                       Text="💊"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{loc:Translate Main_NextMedEyebrow}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="10.5"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.1"
                                       TextColor="{StaticResource InkTertiary}"/>
                                <Label x:Name="NextMedName"
                                       Text="{loc:Translate Main_MedsPlaceholder}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="14.5"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"/>
                                <Label x:Name="NextMedDetail"
                                       Text="{loc:Translate Main_MedicationDetailPlaceholder}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12.5"
                                       TextColor="{StaticResource InkSecondary}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="6"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                <Label x:Name="NextMedTime"
                                       Text="08:00"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource InkSecondary}"
                                       HorizontalOptions="End"/>
                                <Button x:Name="NextMedAction"
                                        Text="{loc:Translate Journal_MarkGiven}"
                                        IsVisible="False"
                                        FontFamily="{StaticResource FontSans}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        HeightRequest="34"
                                        Padding="14,0"
                                        CornerRadius="11"
                                        BackgroundColor="{StaticResource Teal}"
                                        TextColor="{StaticResource White}"
                                        Clicked="OnNextUpAction"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Paperclip overlapping the top-left corner (chrome) -->
                    <Path Data="M7 3 L7 17 Q7 21 11 21 Q15 21 15 17 L15 7 Q15 4 12 4 Q10 4 10 7 L10 15"
                          Stroke="{StaticResource InkTertiary}"
                          StrokeThickness="1.6"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          Rotation="-24"
                          WidthRequest="22"
                          HeightRequest="24"
                          HorizontalOptions="Start"
                          VerticalOptions="Start"
                          Margin="10,-6,0,0"/>
                </Grid>

                <!-- 4 ── The two stat cards the owner chooses ──
                     Each holds one record — the pet's latest value for it and when it
                     was written down. Tapping ANYWHERE on a card opens the picker; the
                     pencil in its corner is only a cue. Defaults follow the pet's
                     conditions (see Data/Models/TodayCards.cs). -->
                <VerticalStackLayout Spacing="6">

                    <!-- First run only: the note that says the cards can be changed, in
                         the page's own handwriting, with a small looping arrow either
                         side dropping toward the cards, so there is no doubt what it
                         points at. It sits ABOVE the pair (under them it read as a
                         caption for the page) and stays centred as one compact note.

                         It retires the moment the owner opens the picker; after that the
                         pencil on each card carries the affordance, because a permanent
                         instruction would make Today read like a settings screen. -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="3"
                          HorizontalOptions="Center"
                          Margin="0,0,0,-8"
                          IsVisible="{Binding MainPageVM.ShowCardHint}">

                        <!-- Left arrow: leaves the note, loops once, and drops toward the
                             left card. It hugs the text rather than reaching for the
                             page edge — spread wide it stopped reading as one gesture.
                             Drawn, not an icon: same pen as the aside under the greeting. -->
                        <Path Grid.Column="0"
                              Data="M 30 5 C 22 2, 13 3.5, 10 9.5 C 8 13.5, 13 17, 15 13 C 17 9, 11.5 7, 8 11 C 4 15.5, 5 20.5, 7 24 M 7 24 L 2 21 M 7 24 L 7 18.5"
                              Stroke="{StaticResource TealDeep}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              WidthRequest="33"
                              HeightRequest="27"
                              VerticalOptions="End"/>

                        <Label Grid.Column="1"
                               Text="{Binding MainPageVM.CardHintText}"
                               FontFamily="{StaticResource FontHand}"
                               FontSize="18.5"
                               TextColor="{StaticResource TealDeep}"
                               MaximumWidthRequest="215"
                               LineBreakMode="WordWrap"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <!-- Same doodle mirrored, so the pair reads as one hand's work. -->
                        <Path Grid.Column="2"
                              Data="M 30 5 C 22 2, 13 3.5, 10 9.5 C 8 13.5, 13 17, 15 13 C 17 9, 11.5 7, 8 11 C 4 15.5, 5 20.5, 7 24 M 7 24 L 2 21 M 7 24 L 7 18.5"
                              Stroke="{StaticResource TealDeep}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              ScaleX="-1"
                              WidthRequest="33"
                              HeightRequest="27"
                              VerticalOptions="End"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <controls:TodayStatCardView BindingContext="{Binding MainPageVM.PrimaryCard}"/>
                        <controls:TodayStatCardView Grid.Column="1"
                                                    Mirrored="True"
                                                    BindingContext="{Binding MainPageVM.SecondaryCard}"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- 5 ── Looking back ──
                     One block per record in the pet's CARE PLAN, in fixed catalog
                     order, for every record that has anything in the range.

                     This replaced a hardcoded mood ribbon and a hardcoded weight
                     chart. The top of this page already follows the pet — the ring,
                     next-up and the two cards all derive from the plan or the pet's
                     conditions — while the bottom drew the same two records for
                     everyone, so an owner managing a diabetic cat scrolled past a
                     glucose card into a weight chart and a mood ribbon.

                     It is NOT a dashboard and adds no knob: the care plan is the list
                     the owner already curated on Manage, and the single range selector
                     is the one the weight chart already had. Nothing here is ordered by
                     volume and no record is dropped for being quiet — that would be the
                     app deciding which one matters (Data/Models/RecordFacts.cs). -->
                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding LookBackVM.HasBlocks}">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Text="{Binding LookBackVM.Heading}"
                               Style="{StaticResource SerifHeading}"
                               VerticalOptions="Center"/>

                        <!-- One range for the whole section: a per-block range would be
                             a knob per record, which is exactly the settings screen this
                             page must not become. -->
                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource Well}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                Padding="3">
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="0" WidthRequest="168">

                                <Border Grid.Column="0" BackgroundColor="Transparent"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 999">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding LookBackVM.RangeDays}" Value="14">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Glass}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LookBackVM.SetRangeCommand}" CommandParameter="14"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{loc:Translate Today_Range2W}" Style="{StaticResource RangeTab}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding LookBackVM.RangeDays}" Value="14">
                                                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Border Grid.Column="1" BackgroundColor="Transparent"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 999">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding LookBackVM.RangeDays}" Value="30">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Glass}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LookBackVM.SetRangeCommand}" CommandParameter="30"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{loc:Translate Today_Range1M}" Style="{StaticResource RangeTab}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding LookBackVM.RangeDays}" Value="30">
                                                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Border Grid.Column="2" BackgroundColor="Transparent"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 999">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding LookBackVM.RangeDays}" Value="90">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Glass}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LookBackVM.SetRangeCommand}" CommandParameter="90"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{loc:Translate Today_Range3M}" Style="{StaticResource RangeTab}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding LookBackVM.RangeDays}" Value="90">
                                                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <Border Grid.Column="3" BackgroundColor="Transparent"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 999">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding LookBackVM.RangeDays}" Value="365">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Glass}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding LookBackVM.SetRangeCommand}" CommandParameter="365"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{loc:Translate Today_Range1Y}" Style="{StaticResource RangeTab}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding LookBackVM.RangeDays}" Value="365">
                                                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding LookBackVM.Blocks}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vms:LookBackBlock">
                                <Border Style="{StaticResource GlassCard}">
                                    <VerticalStackLayout Spacing="10">

                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Icon}" FontSize="15" VerticalOptions="Center"/>
                                            <Label Text="{Binding Name}"
                                                   FontFamily="{StaticResource FontSans}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Ink}"
                                                   VerticalOptions="Center"/>
                                        </HorizontalStackLayout>

                                        <!-- Measured: a line over time. X is WHEN it was
                                             written down, never the index of the reading;
                                             straight segments, a dot on every real entry,
                                             and no line across a long gap. -->
                                        <Label Text="{loc:Translate Today_Measured}"
                                               IsVisible="{Binding IsDualStore}"
                                               FontFamily="{StaticResource FontSans}"
                                               FontSize="10.5"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1"
                                               TextColor="{StaticResource InkTertiary}"/>
                                        <GraphicsView Drawable="{Binding Chart}"
                                                      IsVisible="{Binding HasChart}"
                                                      HeightRequest="118"
                                                      HorizontalOptions="Fill"
                                                      InputTransparent="True"/>

                                        <!-- Observed: one mark per reading, placed by date,
                                             heighted by the stored level. Named separately
                                             when a record holds both, because measurements
                                             and observations are never merged into one
                                             picture (AI/design-decisions.md). -->
                                        <Label Text="{loc:Translate Today_Observed}"
                                               IsVisible="{Binding IsDualStore}"
                                               FontFamily="{StaticResource FontSans}"
                                               FontSize="10.5"
                                               FontAttributes="Bold"
                                               CharacterSpacing="1"
                                               TextColor="{StaticResource InkTertiary}"
                                               Margin="0,4,0,0"/>
                                        <GraphicsView Drawable="{Binding Observations}"
                                                      IsVisible="{Binding HasObservations}"
                                                      HeightRequest="34"
                                                      HorizontalOptions="Fill"
                                                      InputTransparent="True"/>

                                        <!-- Events: one mark per occurrence, at the moment
                                             it happened. Same size, same colour, always —
                                             nothing is encoded but when. -->
                                        <GraphicsView Drawable="{Binding Events}"
                                                      IsVisible="{Binding HasEvents}"
                                                      HeightRequest="34"
                                                      HorizontalOptions="Fill"
                                                      InputTransparent="True"/>

                                        <!-- The dates along the foot. One axis for the
                                             whole block, however many charts sit above it:
                                             they cover the same stretch, and a second axis
                                             would suggest they did not. Inset by the same
                                             6px the drawables pad by, so a label sits over
                                             the day it names. -->
                                        <AbsoluteLayout IsVisible="{Binding HasAxis}"
                                                        HeightRequest="14"
                                                        Margin="6,2,6,0"
                                                        BindableLayout.ItemsSource="{Binding Axis}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vms:AxisTick">
                                                    <Label Text="{Binding Label}"
                                                           AbsoluteLayout.LayoutBounds="{Binding Bounds}"
                                                           AbsoluteLayout.LayoutFlags="XProportional"
                                                           FontFamily="{StaticResource FontSans}"
                                                           FontSize="10"
                                                           TextColor="{StaticResource InkTertiary}"/>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </AbsoluteLayout>

                                        <!-- The facts, in the same words the card sheet and
                                             the appointment summary state them. One weight,
                                             one colour: nothing here is emphasised. -->
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Count}"
                                                   FontFamily="{StaticResource FontSans}"
                                                   FontSize="12.5"
                                                   TextColor="{StaticResource InkSecondary}"/>
                                            <Label Text="{Binding DayParts}"
                                                   FontFamily="{StaticResource FontSans}"
                                                   FontSize="12.5"
                                                   TextColor="{StaticResource InkSecondary}"/>
                                            <Label Text="{Binding Values}"
                                                   IsVisible="{Binding HasValues}"
                                                   FontFamily="{StaticResource FontSans}"
                                                   FontSize="12.5"
                                                   TextColor="{StaticResource InkSecondary}"/>
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= TAB BAR ================= -->
        <controls:BottomNavigation Grid.Row="1"
                                   ActiveTab="Main"/>

        <!-- Confirm micro-interaction overlay (bubbles) -->
        <AbsoluteLayout x:Name="EffectLayer"
                        Grid.RowSpan="2"
                        InputTransparent="True"
                        IsClippedToBounds="False"/>

        <!-- Toast (warm confirmation pill) -->
        <Border x:Name="Toast"
                Grid.RowSpan="2"
                Opacity="0"
                InputTransparent="True"
                BackgroundColor="{StaticResource Ink}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18,15,14,17"
                Rotation="-0.5"
                Padding="14,11"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,92">
            <Border.Shadow>
                <Shadow Brush="#0D3A3C"
                        Offset="0,12"
                        Radius="34"
                        Opacity="0.20"/>
            </Border.Shadow>
            <HorizontalStackLayout Spacing="8"
                                   VerticalOptions="Center">
                <Label Text="✓"
                       FontFamily="{StaticResource FontSans}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource MGreat}"
                       VerticalOptions="Center"/>
                <Label x:Name="ToastLabel"
                       FontFamily="{StaticResource FontSans}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <!-- ── Overlay sheets ───────────────────────────────────────────────────
             Each is a SheetHost: the body is built the first time it is needed,
             not when the page inflates. Declaration order is still z-order.
             See Controls/SheetHost.cs for why. -->

        <!-- Today stat-card picker ("what matters most today?") -->
        <controls:SheetHost Grid.RowSpan="2"
                            BindingContext="{Binding TodayCardSheetVM}"
                            Presented="{Binding IsPresented}"
                            SheetTemplate="{DataTemplate view:TodayCardSheetView}"/>

        <!-- Cloud Features sheet (FelovaBottomSheet; click-through while closed) -->
        <controls:SheetHost Grid.RowSpan="2"
                            BindingContext="{Binding CloudVM}"
                            Presented="{Binding IsPresented}"
                            SheetTemplate="{DataTemplate view:CloudSheetView}"/>

        <!-- Monetization sheets (subscribe + grant messages + access code) -->
        <controls:SheetHost Grid.RowSpan="2"
                            BindingContext="{Binding SubscribeVM}"
                            Presented="{Binding IsPresented}"
                            SheetTemplate="{DataTemplate view:SubscribeSheetView}"/>
        <controls:SheetHost Grid.RowSpan="2"
                            BindingContext="{Binding AccessMessageVM}"
                            Presented="{Binding IsPresented}"
                            SheetTemplate="{DataTemplate view:AccessMessageSheetView}"/>
        <controls:SheetHost Grid.RowSpan="2"
                            BindingContext="{Binding RedeemVM}"
                            Presented="{Binding IsPresented}"
                            SheetTemplate="{DataTemplate view:RedeemCodeSheetView}"/>

        <!-- Hidden developer diagnostics sheet -->
        <controls:SheetHost Grid.RowSpan="2"
                            BindingContext="{Binding DevVM}"
                            Presented="{Binding IsPresented}"
                            SheetTemplate="{DataTemplate view:DevSheetView}"/>

        <!-- Settings panel overlay. Its BindingContext stays the page's MainViewModel
             (the panel reads across several child VMs), and it binds its own
             IsPanelOpen internally — see SettingsPanelView.xaml. -->
        <controls:SheetHost Grid.RowSpan="2"
                            Presented="{Binding SettingsVM.IsPanelOpen}"
                            SheetTemplate="{DataTemplate view:SettingsPanelView}"/>

        <!-- Confirm sheet LAST, so it renders above the settings panel: "Delete all data"
             is reached from inside that panel, which stays open behind the question. -->
        <controls:SheetHost Grid.RowSpan="2"
                            BindingContext="{Binding ConfirmVM}"
                            Presented="{Binding IsPresented}"
                            SheetTemplate="{DataTemplate view:ConfirmSheetView}"/>

    </Grid>

</ContentPage>
