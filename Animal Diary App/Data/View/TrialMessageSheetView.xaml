<?xml version="1.0" encoding="utf-8" ?>
<!-- TrialMessageSheetView — the three quiet trial moments (explainer / pre-end nudge /
     read-only reassurance) on one reusable FelovaBottomSheet. Reassures first; the
     "Continue with Felova" button (→ subscribe) shows only on the nudge and read-only
     states, never the explainer. BindingContext is a TrialMessageViewModel. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Animal_Diary_App.Data.View.Controls"
             xmlns:vms="clr-namespace:Animal_Diary_App.Data.ViewModels"
             x:DataType="vms:TrialMessageViewModel"
             x:Class="Animal_Diary_App.Data.View.TrialMessageSheetView"
             x:Name="Root"
             InputTransparent="{Binding IsPresented, Converter={StaticResource InvertedBoolConverter}}">

    <controls:FelovaBottomSheet IsPresented="{Binding IsPresented}"
                                Title="{Binding Title}"
                                DismissCommand="{Binding DismissCommand}">
        <controls:FelovaBottomSheet.SheetContent>
            <VerticalStackLayout Spacing="16" Padding="0,2,0,0">

                <Label Text="{Binding Body}" FontFamily="{StaticResource FontSans}"
                       FontSize="14" LineHeight="1.45" TextColor="{StaticResource InkSecondary}"/>

                <!-- Explainer only: the single low-key subscribe line (no button) -->
                <Label Text="{Binding Footnote}" IsVisible="{Binding HasFootnote}"
                       FontFamily="{StaticResource FontSans}" FontSize="12.5"
                       TextColor="{StaticResource InkTertiary}"/>

                <!-- Nudge / read-only: continue with Felova (→ subscribe) -->
                <Border BackgroundColor="{StaticResource Teal}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 13,16,15,14" IsVisible="{Binding ShowContinue}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ContinueCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="{Binding ContinueLabel}" FontFamily="{StaticResource FontSans}" FontSize="14"
                           FontAttributes="Bold" TextColor="{StaticResource White}"
                           HorizontalTextAlignment="Center" Padding="0,14"/>
                </Border>

                <!-- Dismiss ("Not now" / "Okay") -->
                <Label Text="{Binding DismissLabel}" Padding="0,4"
                       FontFamily="{StaticResource FontSans}" FontSize="12.5" FontAttributes="Bold"
                       TextColor="{StaticResource TealDeep}" HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DismissCommand}"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </controls:FelovaBottomSheet.SheetContent>
    </controls:FelovaBottomSheet>
</ContentView>
