<?xml version="1.0" encoding="utf-8" ?>
<!-- ConfirmSheetView: the app's multi-choice confirmation, replacing DisplayActionSheet
     wherever there are more than two outcomes. Every option is a real card, so the safe
     one can't end up looking like body text next to a styled destructive button (which
     is exactly what the native action sheet did). BindingContext is a
     ConfirmSheetViewModel. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Animal_Diary_App.Data.View.Controls"
             xmlns:vms="clr-namespace:Animal_Diary_App.Data.ViewModels"
             x:DataType="vms:ConfirmSheetViewModel"
             x:Class="Animal_Diary_App.Data.View.ConfirmSheetView"
             x:Name="Root"
             InputTransparent="{Binding IsPresented, Converter={StaticResource InvertedBoolConverter}}">

    <controls:FelovaBottomSheet IsPresented="{Binding IsPresented}"
                                Title="{Binding Title}"
                                DismissCommand="{Binding DismissCommand}">
        <controls:FelovaBottomSheet.SheetContent>
            <VerticalStackLayout Spacing="12" Padding="0,2,0,0">

                <Label Text="{Binding Body}"
                       IsVisible="{Binding HasBody}"
                       FontFamily="{StaticResource FontSans}"
                       FontSize="14"
                       LineHeight="1.45"
                       TextColor="{StaticResource InkSecondary}"/>

                <!-- BindableLayout, not CollectionView: a handful of fixed rows with no
                     scrolling is BindableLayout's documented use case, and CollectionView's
                     RecyclerView wouldn't render inside this auto-sized sheet until scrolled.
                     Safe here because FelovaBottomSheet keeps its body realised while hidden
                     (translated off-screen, never IsVisible=false). -->
                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vms:ConfirmOption">
                            <Border BackgroundColor="{StaticResource Glass}"
                                    Stroke="{StaticResource GlassLine}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 16,13,15,14"
                                    Padding="16,14">
                                <!-- Destructive reads in the rose accent. It is the
                                     consequence, never the default-looking way out. -->
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsDestructive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource RoseTint}"/>
                                        <Setter Property="Stroke" Value="{StaticResource Rose}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.PickCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Label}"
                                           FontFamily="{StaticResource FontSans}"
                                           FontSize="14.5"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Ink}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsDestructive}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource RoseDeep}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Description}"
                                           IsVisible="{Binding HasDescription}"
                                           FontFamily="{StaticResource FontSans}"
                                           FontSize="12"
                                           LineHeight="1.35"
                                           TextColor="{StaticResource InkSecondary}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Cancel: the same quiet text link every other sheet closes with.
                     Backing out needs no emphasis: it costs nothing. -->
                <Label Text="{Binding CancelLabel}"
                       Padding="0,4"
                       FontFamily="{StaticResource FontSans}"
                       FontSize="12.5"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TealDeep}"
                       HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DismissCommand}"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </controls:FelovaBottomSheet.SheetContent>
    </controls:FelovaBottomSheet>
</ContentView>
