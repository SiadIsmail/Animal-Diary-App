<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:Animal_Diary_App.Data.View"
             xmlns:loc="clr-namespace:Animal_Diary_App.Helpers"
             xmlns:controls="clr-namespace:Animal_Diary_App.Data.View.Controls"
             xmlns:vms="clr-namespace:Animal_Diary_App.Data.ViewModels"
             x:DataType="vms:MainViewModel"
             xmlns:models="clr-namespace:Animal_Diary_App.Data.Models"
             x:Class="Animal_Diary_App.Data.View.PetsPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#C4E6E3">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Felova card surface -->
            <Style x:Key="CardSurface" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Glass}"/>
                <Setter Property="Stroke" Value="{StaticResource GlassLine}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 17,14,15,18"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <!-- Uppercase section eyebrow -->
            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CharacterSpacing" Value="1.3"/>
                <Setter Property="TextColor" Value="{StaticResource InkSecondary}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Water background — bottom layer, spans the whole page -->
        <controls:WaterBackground Grid.RowSpan="2"/>

        <!-- ================= CARE ================= -->
        <ScrollView Grid.Row="0">

            <VerticalStackLayout Padding="22,26,22,20"
                                 Spacing="22">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="{loc:Translate Care_Eyebrow}"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1.3"
                               TextColor="{StaticResource InkTertiary}"/>
                        <Label Text="{loc:Translate Care_Title}"
                               FontFamily="{StaticResource FontSerif}"
                               FontSize="{StaticResource TypeH1}"
                               TextColor="{StaticResource Ink}"/>
                    </VerticalStackLayout>

                    <!-- Settings button -->
                    <Border Grid.Column="1"
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="{StaticResource Glass}"
                            Stroke="{StaticResource GlassLine}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SettingsVM.OpenSettingsCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="⚙️"
                               FontSize="17"
                               TextColor="{StaticResource InkSecondary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- ═══════════ YOUR PETS ═══════════ -->
                <Label Text="{loc:Translate Care_YourPets}"
                       Style="{StaticResource SectionLabel}"/>

                <!-- Pet switcher -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8"
                                           BindableLayout.ItemsSource="{Binding PetVM.Pets}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Pet">
                                <Border StrokeThickness="1"
                                        Stroke="{StaticResource GlassLine}"
                                        BackgroundColor="{StaticResource Glass}"
                                        StrokeShape="RoundRectangle 999"
                                        Padding="7,7,14,7">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Ink}"/>
                                            <Setter Property="Stroke" Value="{StaticResource Ink}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PetVM.SelectPetCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Border WidthRequest="26"
                                                HeightRequest="26"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 13"
                                                BackgroundColor="{StaticResource TealTint}"
                                                VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#28FFFFFF"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="🐾"
                                                   FontSize="12"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <Label Text="{Binding Name}"
                                               FontFamily="{StaticResource FontSans}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource InkSecondary}"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Active pet card -->
                <Border Style="{StaticResource CardSurface}"
                        Padding="18">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                            <!-- Avatar — profile photo, or the type emoji fallback -->
                            <controls:PetAvatarView Grid.Column="0"
                                                    Diameter="60"
                                                    FallbackFontSize="30"
                                                    PhotoPath="{Binding PetVM.ActivePet.PhotoFullPath}"
                                                    FallbackText="{Binding PetVM.ActivePetEmoji}"
                                                    VerticalOptions="Center"/>

                            <!-- Info -->
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="{Binding PetVM.ActivePet.Name}"
                                       FontFamily="{StaticResource FontSerif}"
                                       FontSize="21"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="{Binding PetVM.ActivePetSubtitle}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12.5"
                                       TextColor="{StaticResource InkSecondary}"/>

                                <!-- Tags — the pet's real conditions, then its
                                     medication count. Empty when it has neither. -->
                                <FlexLayout Wrap="Wrap"
                                            Direction="Row"
                                            AlignItems="Start"
                                            Margin="0,8,0,0"
                                            BindableLayout.ItemsSource="{Binding PetVM.ActivePetTags}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vms:PetProfileTag">
                                            <!-- Shrink="0": a chip is sized by its text and must never be
                                                 compressed below it. FlexLayout defaults Shrink="1", so an
                                                 overflowing row squeezes its items — and because this chip's
                                                 content is a bare Label (every other chip row in the app puts
                                                 a HorizontalStackLayout in between), the Label absorbed the
                                                 squeeze by word-wrapping to a second line that the one-line
                                                 pill then clipped. That is why "Epilepsie / Anfälle" rendered
                                                 as "Epilepsie /" with no ellipsis. Wrap="Wrap" already gives
                                                 an oversized chip its own row, which is the behaviour we want
                                                 instead of compression. -->
                                            <Border FlexLayout.Shrink="0"
                                                    BackgroundColor="{StaticResource Well}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 999"
                                                    Padding="10,4"
                                                    Margin="0,0,6,6">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsMedication}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource TealTint}"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <!-- NoWrap over the Label default of WordWrap: a pill is a
                                                     one-line shape, so there is no second line for the Border
                                                     to clip. It also makes the Label report the full string
                                                     width when measured, so the chip asks for the room the
                                                     German copy actually needs rather than settling for
                                                     whatever the star column offered. -->
                                                <Label Text="{Binding Label}"
                                                       LineBreakMode="NoWrap"
                                                       FontFamily="{StaticResource FontSans}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource InkSecondary}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsMedication}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource TealDeep}"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Actions — the two doors that CHANGE what Felova does for this
                             pet, kept on the pet itself rather than in the row list below.
                             Both are pet-scoped, so the switcher above visibly governs
                             them; the rows below are the reading surfaces. Medication used
                             to be the first row of a six-row "Quick management" card, where
                             it was the only entry that configured anything. -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="{loc:Translate Pets_Manage}"
                                    FontFamily="{StaticResource FontSans}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    HeightRequest="44"
                                    CornerRadius="14"
                                    BackgroundColor="{StaticResource Teal}"
                                    TextColor="{StaticResource White}"
                                    Clicked="OnManageClicked"/>
                            <Button Grid.Column="1"
                                    Text="{loc:Translate Pets_Medication}"
                                    FontFamily="{StaticResource FontSans}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    HeightRequest="44"
                                    CornerRadius="14"
                                    BackgroundColor="{StaticResource Well}"
                                    TextColor="{StaticResource TealDeep}"
                                    BorderColor="{StaticResource TealLine}"
                                    BorderWidth="1"
                                    Clicked="OnMedicationClicked"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Add a pet -->
                <Border BackgroundColor="{StaticResource Glass}"
                        Stroke="{StaticResource TealLine}"
                        StrokeThickness="1.5"
                        StrokeDashArray="4,3"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddPetClicked"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label Text="🐾" FontSize="16" VerticalOptions="Center"/>
                        <Label Text="{loc:Translate Pets_AddPet}"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="13.5"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TealDeep}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- ═══════════ THE RECORD ═══════════
                     The three surfaces that READ what is already written down and take it
                     out of the app. None of them changes anything, which is what separates
                     them from the pet card above. The heading carries the pet's name
                     because every row here follows the switcher, and nothing else on the
                     card said so. -->
                <Label Text="{Binding PetVM.RecordSectionTitle}"
                       Style="{StaticResource SectionLabel}"/>

                <Border Style="{StaticResource CardSurface}"
                        Padding="4">
                    <VerticalStackLayout>

                        <!-- Vet summary — first, because it is the reason most people open
                             this tab, and it sat fourth of six before. -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              Padding="14,15">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ExportSheetVM.OpenCommand}"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource BlueTint}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 13"
                                    VerticalOptions="Center">
                                <Label Text="📤" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Pets_Export}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="{loc:Translate Pets_ExportSubtitle}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12"
                                       TextColor="{StaticResource InkSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="{StaticResource InkTertiary}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource GlassLine}" Margin="14,0"/>

                        <!-- Documents — directly under Export, because it is where the
                             summaries made by the row above end up. -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              Padding="14,15">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDocumentsClicked"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource BlueTint}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 13"
                                    VerticalOptions="Center">
                                <Label Text="📄" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Pets_Documents}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="{loc:Translate Pets_DocumentsSubtitle}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12"
                                       TextColor="{StaticResource InkSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="{StaticResource InkTertiary}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource GlassLine}" Margin="14,0"/>

                        <!-- Constellation — everything already written down, laid out
                             over time. A way to LOOK at the diary rather than add to
                             it, so it sits with the other reading surfaces (Documents,
                             Export) and not with the logging ones. -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              Padding="14,15">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConstellationClicked"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource BlueTint}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 13"
                                    VerticalOptions="Center">
                                <Label Text="✨" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Pets_Constellation}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="{loc:Translate Pets_ConstellationSubtitle}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12"
                                       TextColor="{StaticResource InkSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="{StaticResource InkTertiary}"
                                   VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════ SHARED CARE ═══════════
                     The two halves of sharing, which used to sit at the bottom of the
                     same list as everything else and read as near-synonyms there. They
                     are titled by DIRECTION now: you invite someone to your pet, or you
                     use a code someone sent you. This is also the one group that isn't
                     purely pet-scoped, which is another reason it can't live under the
                     pet's own heading. -->
                <Label Text="{loc:Translate Care_SharedCare}"
                       Style="{StaticResource SectionLabel}"/>

                <Border Style="{StaticResource CardSurface}"
                        Padding="4">
                    <VerticalStackLayout>

                        <!-- Invite someone — first-class here, not buried in Manage. Opens
                             the sharing sheet when cloud is set up, otherwise the account
                             door (sharing rides the sync, so it needs an account + backup).
                             The sheet also lists who is already helping, which is what the
                             subtitle's second half promises. -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              Padding="14,15">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShareClicked"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource TealTint}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 13"
                                    VerticalOptions="Center">
                                <Label Text="🤝" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Care_ShareRowTitle}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="{loc:Translate Care_ShareRowSubtitle}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12"
                                       TextColor="{StaticResource InkSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="{StaticResource InkTertiary}"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource GlassLine}" Margin="14,0"/>

                        <!-- Use an invite code — the caregiver side of sharing, first-class
                             here instead of buried in the cloud sheet. -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              Padding="14,15">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnJoinPetClicked"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource TealTint}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 13"
                                    VerticalOptions="Center">
                                <Label Text="🔑" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{loc:Translate Care_JoinRowTitle}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="{loc:Translate Care_JoinRowSubtitle}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12"
                                       TextColor="{StaticResource InkSecondary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›"
                                   FontSize="22" TextColor="{StaticResource InkTertiary}"
                                   VerticalOptions="Center"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ═══════════ FEEDBACK ═══════════
                     Last on the page, but deliberately NOT quiet: this is the only surface
                     that asks the owner for something, and an understated row at the end of
                     a scroll gets ignored. It gets the page's group-heading treatment like
                     every other section, a teal stroke instead of the GlassLine every other
                     card wears, and a filled button — so it reads as an invitation rather
                     than a seventh destination.
                     The copy asks for the thing, not the channel: Discord and the direct
                     email are only named once the sheet is open. -->
                <Label Text="{loc:Translate Care_FeedbackSection}"
                       Style="{StaticResource SectionLabel}"/>

                <Border BackgroundColor="{StaticResource Glass}"
                        Stroke="{StaticResource TealLine}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 17,14,15,18"
                        Padding="18">
                    <!-- The whole card stays tappable as well as the button: the button is
                         the signal, not the only target. -->
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FeedbackVM.OpenCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    WidthRequest="44" HeightRequest="44"
                                    BackgroundColor="{StaticResource TealTint}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    VerticalOptions="Center">
                                <Label Text="💬" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Translate Feedback_RowTitle}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="{loc:Translate Feedback_RowSubtitle}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="12.5"
                                       TextColor="{StaticResource InkSecondary}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="{loc:Translate Feedback_RowAction}"
                                FontFamily="{StaticResource FontSans}"
                                FontSize="13.5"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                CornerRadius="14"
                                BackgroundColor="{StaticResource Teal}"
                                TextColor="{StaticResource White}"
                                Command="{Binding FeedbackVM.OpenCommand}"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= TAB BAR ================= -->
        <controls:BottomNavigation Grid.Row="1"
                                   ActiveTab="Pets"/>

        <!-- Export sheet overlay (FelovaBottomSheet; click-through while closed) -->
        <view:ExportSheetView Grid.RowSpan="2"
                              BindingContext="{Binding ExportSheetVM}"/>

        <!-- Cloud Features sheet (FelovaBottomSheet; click-through while closed) -->
        <view:CloudSheetView Grid.RowSpan="2"
                             BindingContext="{Binding CloudVM}"/>

        <!-- Monetization sheets (subscribe + trial messages + access code) -->
        <view:SubscribeSheetView Grid.RowSpan="2" BindingContext="{Binding SubscribeVM}"/>
        <view:TrialMessageSheetView Grid.RowSpan="2" BindingContext="{Binding TrialMessageVM}"/>
        <view:RedeemCodeSheetView Grid.RowSpan="2" BindingContext="{Binding RedeemVM}"/>

        <!-- Shared-care sheet (FelovaBottomSheet; click-through while closed) -->
        <view:SharingSheetView Grid.RowSpan="2"
                               BindingContext="{Binding SharingVM}"/>

        <!-- Feedback sheet (FelovaBottomSheet; click-through while closed) -->
        <view:FeedbackSheetView Grid.RowSpan="2"
                                BindingContext="{Binding FeedbackVM}"/>

        <!-- Hidden developer diagnostics sheet -->
        <view:DevSheetView Grid.RowSpan="2"
                           BindingContext="{Binding DevVM}"/>

        <!-- Settings panel overlay -->
        <view:SettingsPanelView Grid.RowSpan="2"
                                IsPanelOpen="{Binding SettingsVM.IsPanelOpen, Mode=TwoWay}"/>

        <!-- Confirm sheet LAST, so it renders above the settings panel: "Delete all data"
             and sign-out are both reached from inside that panel, which stays open behind
             the question. Also makes it the top-most overlay for Android back. -->
        <view:ConfirmSheetView Grid.RowSpan="2"
                               BindingContext="{Binding ConfirmVM}"/>

    </Grid>

</ContentPage>
