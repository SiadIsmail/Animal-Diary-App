<?xml version="1.0" encoding="utf-8" ?>
<!--
    ImportPage.xaml
    ─────────────────────────────────────────────────────────
    The AI entry importer, reached from Settings → "Code" → the import code. Pick a
    Felova import file, read what it will do, confirm. Nothing is written until the
    Import button on the preview is tapped, and a file with any error writes nothing
    at all.

    English-only by intent — an internal tool behind a code, like DevSheetView. See
    ImportViewModel for why, and for the day that has to change.

    BindingContext is the MainViewModel; content binds through ImportVM.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vms="clr-namespace:Animal_Diary_App.Data.ViewModels"
             xmlns:controls="clr-namespace:Animal_Diary_App.Data.View.Controls"
             x:DataType="vms:MainViewModel"
             x:Class="Animal_Diary_App.Data.View.ImportPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#C4E6E3">

    <Grid>

        <controls:WaterBackground/>

        <ScrollView>
            <VerticalStackLayout Padding="22,20,22,40" Spacing="14">

                <!-- Subhead: back + title -->
                <Grid ColumnDefinitions="40,*,40" ColumnSpacing="10" Margin="0,0,0,8">
                    <Border Grid.Column="0"
                            WidthRequest="40" HeightRequest="40"
                            BackgroundColor="{StaticResource Glass}"
                            Stroke="{StaticResource GlassLine}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="‹" FontSize="26"
                               TextColor="{StaticResource InkSecondary}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="Import entries"
                               FontFamily="{StaticResource FontSerif}"
                               FontSize="21"
                               TextColor="{StaticResource Ink}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding ImportVM.FileName}"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="11"
                               TextColor="{StaticResource InkTertiary}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- ── Nothing chosen yet ───────────────────────────────────── -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding ImportVM.IsEmpty}">
                    <Label Text="Choose a Felova import file — a JSON file written from a pet owner's notes. You will see exactly what it does before anything is saved."
                           FontFamily="{StaticResource FontSans}"
                           FontSize="13" LineHeight="1.35"
                           TextColor="{StaticResource InkSecondary}"
                           HorizontalTextAlignment="Center"
                           Margin="0,20,0,0"/>
                </VerticalStackLayout>

                <!-- ── Headline (every state after the first) ────────────────── -->
                <Border BackgroundColor="{StaticResource TealTint}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12"
                        IsVisible="{Binding ImportVM.Headline, Converter={StaticResource StringToBoolConverter}}">
                    <Label Text="{Binding ImportVM.Headline}"
                           FontFamily="{StaticResource FontSans}"
                           FontSize="13.5" FontAttributes="Bold" LineHeight="1.3"
                           TextColor="{StaticResource Ink}"/>
                </Border>

                <!-- ── What will happen, per pet ─────────────────────────────── -->
                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding ImportVM.Summaries}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border BackgroundColor="{StaticResource Glass}"
                                    Stroke="{StaticResource GlassLine}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14,12">
                                <Label Text="{Binding .}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="13" LineHeight="1.35"
                                       TextColor="{StaticResource Ink}"/>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ── Errors (rejected) or notices (preview) ────────────────── -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding ImportVM.HasProblems}">

                    <Label Text="{Binding ImportVM.ProblemsHeader}"
                           FontFamily="{StaticResource FontSans}"
                           FontSize="11.5" FontAttributes="Bold"
                           TextColor="{StaticResource InkSecondary}"
                           Margin="2,6,0,0"/>

                    <VerticalStackLayout Spacing="8"
                                         BindableLayout.ItemsSource="{Binding ImportVM.Problems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border BackgroundColor="{StaticResource ClayTint}"
                                        Stroke="#EFD3CE"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12,10">
                                    <Label Text="{Binding .}"
                                           FontFamily="{StaticResource FontSans}"
                                           FontSize="12" LineHeight="1.35"
                                           TextColor="{StaticResource Clay}"/>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- ── Actions ───────────────────────────────────────────────── -->

                <!-- Choose a file: the only action in the empty and rejected states. -->
                <Border BackgroundColor="{StaticResource Teal}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        Margin="0,8,0,0"
                        IsEnabled="{Binding ImportVM.Idle}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ImportVM.IsPreview}" Value="True">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding ImportVM.IsDone}" Value="True">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ImportVM.PickCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="Choose file"
                           FontFamily="{StaticResource FontSans}"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalTextAlignment="Center" Padding="0,14"/>
                </Border>

                <!-- Confirm / cancel: preview only. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0"
                      IsVisible="{Binding ImportVM.IsPreview}"
                      IsEnabled="{Binding ImportVM.Idle}">
                    <Border BackgroundColor="{StaticResource Teal}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ImportVM.ConfirmCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="Import"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalTextAlignment="Center" Padding="0,14"/>
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource Glass}"
                            Stroke="{StaticResource GlassLine}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ImportVM.StartOverCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="Cancel"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Ink}"
                               HorizontalTextAlignment="Center" Padding="0,14"/>
                    </Border>
                </Grid>

                <!-- Done: import another, or leave. -->
                <Border BackgroundColor="{StaticResource Glass}"
                        Stroke="{StaticResource GlassLine}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 14"
                        Margin="0,8,0,0"
                        IsVisible="{Binding ImportVM.IsDone}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ImportVM.StartOverCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="Import another file"
                           FontFamily="{StaticResource FontSans}"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource Ink}"
                           HorizontalTextAlignment="Center" Padding="0,14"/>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
