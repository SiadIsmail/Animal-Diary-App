<?xml version="1.0" encoding="utf-8" ?>
<!-- RedeemCodeSheetView — entering a code, on the shared FelovaBottomSheet. ONE box for both
     kinds: a creator code (public, grants nothing, works signed out) and an access code
     (unique, grants a year, needs an account). The server decides which was typed; the user
     is never asked. The sign-in hand-off is a RESULT state, shown only when a submitted code
     turned out not to be a creator code while signed out — gating the box on sign-in would
     block creator codes, whose whole audience has no account yet. Reached from Settings
     only, never from the subscribe sheet. BindingContext is a RedeemCodeSheetViewModel. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Animal_Diary_App.Data.View.Controls"
             xmlns:loc="clr-namespace:Animal_Diary_App.Helpers"
             xmlns:vms="clr-namespace:Animal_Diary_App.Data.ViewModels"
             x:DataType="vms:RedeemCodeSheetViewModel"
             x:Class="Animal_Diary_App.Data.View.RedeemCodeSheetView"
             x:Name="Root"
             InputTransparent="{Binding IsPresented, Converter={StaticResource InvertedBoolConverter}}">

    <controls:FelovaBottomSheet IsPresented="{Binding IsPresented}"
                                Title="{loc:Translate Redeem_Title}"
                                Subtitle="{loc:Translate Redeem_Subtitle}"
                                DismissCommand="{Binding DismissCommand}">
        <controls:FelovaBottomSheet.SheetContent>
            <VerticalStackLayout Spacing="12" Padding="0,2,0,0">

                <!-- ── The box. Always shown, signed in or not. ── -->
                <VerticalStackLayout Spacing="12" IsEnabled="{Binding CanInteract}">

                    <Border BackgroundColor="{StaticResource Glass}"
                            Stroke="{StaticResource GlassLine}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,4">
                        <Entry Text="{Binding Code}"
                               Placeholder="{loc:Translate Redeem_Placeholder}"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="15"
                               TextColor="{StaticResource Ink}"
                               PlaceholderColor="{StaticResource InkTertiary}"
                               ClearButtonVisibility="WhileEditing"
                               MaxLength="24"
                               ReturnType="Go"
                               ReturnCommand="{Binding RedeemCommand}"/>
                    </Border>

                    <!-- Error and success are mutually exclusive by construction: each is
                         cleared before an attempt, and only one is set after it. -->
                    <Label Text="{Binding ErrorText}"
                           IsVisible="{Binding ErrorText, Converter={StaticResource StringToBoolConverter}}"
                           FontFamily="{StaticResource FontSans}" FontSize="13" LineHeight="1.4"
                           TextColor="{StaticResource RoseDeep}"/>

                    <Label Text="{Binding SuccessText}"
                           IsVisible="{Binding SuccessText, Converter={StaticResource StringToBoolConverter}}"
                           FontFamily="{StaticResource FontSans}" FontSize="13" LineHeight="1.4"
                           TextColor="{StaticResource TealDeep}"/>

                    <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                                       Color="{StaticResource Teal}" HeightRequest="22"/>

                    <Border BackgroundColor="{StaticResource TealTint}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 15,13,13,16"
                            Opacity="{Binding CanRedeem, Converter={StaticResource BoolToOpacityConverter}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RedeemCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="{loc:Translate Redeem_Action}" FontFamily="{StaticResource FontSans}"
                               FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TealDeep}"
                               HorizontalTextAlignment="Center" Padding="0,13"/>
                    </Border>
                </VerticalStackLayout>

                <!-- ── SIGN-IN hand-off. A result, not a mode: only after a submitted code
                     turned out to need an account. ── -->
                <VerticalStackLayout Spacing="14" IsVisible="{Binding NeedsAccount}">

                    <Label Text="{loc:Translate Redeem_NeedsAccount}"
                           FontFamily="{StaticResource FontSans}" FontSize="14" LineHeight="1.45"
                           TextColor="{StaticResource InkSecondary}"/>

                    <Border BackgroundColor="{StaticResource TealTint}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 15,13,13,16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SignInCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="{loc:Translate Redeem_SignInAction}" FontFamily="{StaticResource FontSans}"
                               FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TealDeep}"
                               HorizontalTextAlignment="Center" Padding="0,13"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Done -->
                <Label Text="{loc:Translate Common_Done}" Padding="0,4"
                       FontFamily="{StaticResource FontSans}" FontSize="12.5" FontAttributes="Bold"
                       TextColor="{StaticResource InkSecondary}" HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DismissCommand}"/>
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </controls:FelovaBottomSheet.SheetContent>
    </controls:FelovaBottomSheet>
</ContentView>
