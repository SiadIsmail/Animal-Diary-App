<?xml version="1.0" encoding="utf-8" ?>
<!--
    ConstellationPage.xaml
    ─────────────────────────────────────────────────────────
    One pet's history as a night sky. Pushed from Quick management on the Care page.

    The rule the whole screen obeys:

        Position is WHEN something happened. Symbol is WHAT happened. Density is HOW
        MUCH was recorded. Nothing else is encoded.

    So there is no y-axis, no gridline, no bar and no trend anywhere below — height
    on the canvas means "several at once", never "worse". This is the reading-only
    counterpart to the vet report: the same owner-logged facts, arranged so a year
    can be taken in at a glance without any of it being interpreted.

    THE PAGE IS NOT DARK — the sky is.

    That is the whole of how this belongs to Felova. The first version painted the
    entire screen black and, however much of the app's furniture was added to it, it
    read as a different product wearing Felova's data. So the page is an ordinary
    rockpool morning like every other page here: the same water background, the same
    glass back button, the same serif heading, the same pill range selector, the same
    warm sheet when a star is tapped. The night is CONTAINED — one card, taped to the
    page like the mood note on the Journal, that you look through into the dark.

    Geometry lives in the code-behind (only the page knows how big the canvas is);
    the ViewModel owns the range, the events and the selection.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Animal_Diary_App.Helpers"
             xmlns:controls="clr-namespace:Animal_Diary_App.Data.View.Controls"
             xmlns:vms="clr-namespace:Animal_Diary_App.Data.ViewModels"
             x:DataType="vms:MainViewModel"
             x:Class="Animal_Diary_App.Data.View.ConstellationPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#C4E6E3">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- One range button — the same Well/Glass pill row the weight chart uses,
                 so the two range selectors in this app are one control in two places. -->
            <Style x:Key="SkyRangeTab" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource InkTertiary}"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
                <Setter Property="Padding" Value="0,6"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- The app's own page ground, unchanged from every other page. -->
        <controls:WaterBackground Grid.RowSpan="4"/>

        <!-- ── Header: back + who this is ── -->
        <Grid Grid.Row="0"
              ColumnDefinitions="40,*,40"
              ColumnSpacing="10"
              Padding="22,20,22,12">
            <Border Grid.Column="0"
                    WidthRequest="40" HeightRequest="40"
                    BackgroundColor="{StaticResource Glass}"
                    Stroke="{StaticResource GlassLine}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                </Border.GestureRecognizers>
                <Label Text="‹" FontSize="26"
                       TextColor="{StaticResource InkSecondary}"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="{loc:Translate Sky_Title}"
                       FontFamily="{StaticResource FontSerif}"
                       FontSize="21"
                       TextColor="{StaticResource Ink}"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding ConstellationVM.CountLine}"
                       FontFamily="{StaticResource FontSans}"
                       FontSize="11"
                       TextColor="{StaticResource InkTertiary}"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Share: the sky, framed on a Felova page, to the OS share sheet.
                 Mirrors the back button so the header stays balanced. -->
            <Border x:Name="ShareButton"
                    Grid.Column="2"
                    WidthRequest="40" HeightRequest="40"
                    BackgroundColor="{StaticResource Glass}"
                    Stroke="{StaticResource GlassLine}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    SemanticProperties.Description="{loc:Translate Sky_Share}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnShareClicked"/>
                </Border.GestureRecognizers>
                <Label Text="↗" FontSize="19"
                       TextColor="{StaticResource InkSecondary}"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- ── Range: presets only, like the vet report's look-backs ── -->
        <Border Grid.Row="1"
                Margin="22,0,22,12"
                BackgroundColor="{StaticResource Well}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 999"
                Padding="3">
            <Grid ColumnDefinitions="*,*,*,*">

                <Border Grid.Column="0" BackgroundColor="Transparent"
                        StrokeThickness="0" StrokeShape="RoundRectangle 999">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ConstellationVM.RangeDays}" Value="7">
                            <Setter Property="BackgroundColor" Value="{StaticResource Glass}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ConstellationVM.SetRangeCommand}" CommandParameter="7"/>
                    </Border.GestureRecognizers>
                    <Label Text="{loc:Translate Sky_Range7}" Style="{StaticResource SkyRangeTab}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ConstellationVM.RangeDays}" Value="7">
                                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Grid.Column="1" BackgroundColor="Transparent"
                        StrokeThickness="0" StrokeShape="RoundRectangle 999">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ConstellationVM.RangeDays}" Value="30">
                            <Setter Property="BackgroundColor" Value="{StaticResource Glass}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ConstellationVM.SetRangeCommand}" CommandParameter="30"/>
                    </Border.GestureRecognizers>
                    <Label Text="{loc:Translate Sky_Range30}" Style="{StaticResource SkyRangeTab}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ConstellationVM.RangeDays}" Value="30">
                                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Grid.Column="2" BackgroundColor="Transparent"
                        StrokeThickness="0" StrokeShape="RoundRectangle 999">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ConstellationVM.RangeDays}" Value="90">
                            <Setter Property="BackgroundColor" Value="{StaticResource Glass}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ConstellationVM.SetRangeCommand}" CommandParameter="90"/>
                    </Border.GestureRecognizers>
                    <Label Text="{loc:Translate Sky_Range90}" Style="{StaticResource SkyRangeTab}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ConstellationVM.RangeDays}" Value="90">
                                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <Border Grid.Column="3" BackgroundColor="Transparent"
                        StrokeThickness="0" StrokeShape="RoundRectangle 999">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding ConstellationVM.RangeDays}" Value="365">
                            <Setter Property="BackgroundColor" Value="{StaticResource Glass}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ConstellationVM.SetRangeCommand}" CommandParameter="365"/>
                    </Border.GestureRecognizers>
                    <Label Text="{loc:Translate Sky_Range365}" Style="{StaticResource SkyRangeTab}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding ConstellationVM.RangeDays}" Value="365">
                                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </Grid>
        </Border>

        <!-- ── The night card ──
             Taped to the page, like the Journal's warm-paper mood note: the same
             asymmetric radius, the same soft ink shadow, the same washi strip at a
             few degrees off square. The scrapbook is the app's whole visual idea, and
             this is the one thing in it you look INTO rather than at.

             Gestures live on the host Grid, not on the GraphicsView: the GraphicsView
             is InputTransparent so it can never swallow a drag, and the Grid's own
             background is what makes it hit-testable (the photo cropper's stage does
             the same). -->
        <Grid Grid.Row="2" Margin="18,4,18,0">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 26,20,22,28">
                <Border.Shadow>
                    <Shadow Brush="#0D3A3C" Offset="0,4" Radius="14" Opacity="0.22"/>
                </Border.Shadow>
                <Grid x:Name="SkyHost"
                      BackgroundColor="{StaticResource NightBottom}"
                      SemanticProperties.Description="{Binding ConstellationVM.CountLine}">
                    <Grid.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnPanUpdated"/>
                        <PinchGestureRecognizer PinchUpdated="OnPinchUpdated"/>
                        <TapGestureRecognizer Tapped="OnSkyTapped"/>
                    </Grid.GestureRecognizers>

                    <GraphicsView x:Name="Sky" InputTransparent="True"/>

                    <!-- Nothing recorded in this stretch. Stated plainly and left at
                         that: an empty sky here means nothing was written down, which
                         is not a failure to be nudged about. -->
                    <Label Text="{loc:Translate Sky_Empty}"
                           IsVisible="{Binding ConstellationVM.IsEmpty}"
                           FontFamily="{StaticResource FontSans}"
                           FontSize="13"
                           TextColor="{StaticResource SkyInk}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           Margin="34,0"/>

                    <!-- The figure's name, quietly in the corner. In the app's own
                         handwriting, because this is the one sentence on the page that
                         is about the animal rather than about the records. -->
                    <Label Text="{Binding ConstellationVM.AsterismName}"
                           IsVisible="{Binding ConstellationVM.HasAsterism}"
                           FontFamily="{StaticResource FontHand}"
                           FontSize="16"
                           TextColor="{StaticResource SkyInk}"
                           Opacity="0.75"
                           HorizontalOptions="Start"
                           VerticalOptions="End"
                           Margin="16,0,0,10"
                           InputTransparent="True"/>

                    <!-- The development switch is on and this sky is invented.
                         Unlocalized on purpose, like the hidden dev sheet: it is not a
                         product string, and it must read the same however the phone is
                         set. -->
                    <Border IsVisible="{Binding ConstellationVM.IsSampleSky}"
                            BackgroundColor="{StaticResource Clay}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 999"
                            Padding="12,5"
                            Margin="0,10,0,0"
                            HorizontalOptions="Center"
                            VerticalOptions="Start"
                            InputTransparent="True">
                        <Label Text="SAMPLE DATA — not this pet's records"
                               FontFamily="{StaticResource FontSans}"
                               FontSize="10.5"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Washi tape, holding the night to the page. -->
            <BoxView WidthRequest="62" HeightRequest="17"
                     Color="{StaticResource Washi}"
                     Rotation="-4"
                     HorizontalOptions="Start" VerticalOptions="Start"
                     Margin="26,-8,0,0"
                     InputTransparent="True"/>
            <BoxView WidthRequest="46" HeightRequest="15"
                     Color="{StaticResource Washi}"
                     Rotation="3.5"
                     HorizontalOptions="End" VerticalOptions="End"
                     Margin="0,0,30,-7"
                     InputTransparent="True"/>
        </Grid>

        <!-- ── Legend + how to read it ──
             Each key is a scrap of night at icon-tile size, tilted a degree or two
             like every other tile in the app — which is also what lets a symbol drawn
             for a dark sky read out here on the daylight page. Only the kinds actually
             present are listed (the ViewModel filters), so a pet that has never had a
             seizure is never shown a seizure symbol. -->
        <VerticalStackLayout Grid.Row="3" Padding="16,16,16,16" Spacing="8">

            <FlexLayout Wrap="Wrap"
                        JustifyContent="Center"
                        BindableLayout.ItemsSource="{Binding ConstellationVM.Legend}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vms:CelestialLegendItem">
                        <HorizontalStackLayout Spacing="6"
                                               Margin="0,0,12,7"
                                               VerticalOptions="Center">
                            <Border WidthRequest="27" HeightRequest="27"
                                    BackgroundColor="{StaticResource NightTile}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14,13,14,13"
                                    Rotation="{Binding Tilt}"
                                    VerticalOptions="Center">
                                <GraphicsView Drawable="{Binding Symbol}"
                                              InputTransparent="True"/>
                            </Border>
                            <Label Text="{Binding Label}"
                                   FontFamily="{StaticResource FontSans}"
                                   FontSize="11.5"
                                   TextColor="{StaticResource InkSecondary}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- The app's handwriting, for the one aside on the page. -->
            <Label Text="{loc:Translate Sky_Hint}"
                   FontFamily="{StaticResource FontHand}"
                   FontSize="16"
                   TextColor="{StaticResource InkSecondary}"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <!-- ── One tapped star ──
             The app's own sheet, deliberately: it brings the scrim, the motion and the
             Android-back handling every other overlay here already has. It holds no
             input — it reads back what was written down, and the value appears here
             rather than on the canvas, where it would become a second thing the picture
             encodes. IsPresented is OneWay: the selection is the ViewModel's, and the
             scrim's dismiss goes back through the command. -->
        <controls:FelovaBottomSheet Grid.RowSpan="4"
                                    IsPresented="{Binding ConstellationVM.HasSelection, Mode=OneWay}"
                                    Title="{Binding ConstellationVM.SelectedTitle}"
                                    DismissCommand="{Binding ConstellationVM.ClearSelectionCommand}">
            <controls:FelovaBottomSheet.SheetContent>
                <VerticalStackLayout Spacing="12" Padding="0,2,0,4">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <!-- The same scrap of night the legend wears, so the star you
                             tapped is recognisably the one now being described. -->
                        <Border Grid.Column="0"
                                WidthRequest="40" HeightRequest="40"
                                BackgroundColor="{StaticResource NightTile}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20,19,20,19"
                                Rotation="-3"
                                VerticalOptions="Center">
                            <GraphicsView Drawable="{Binding ConstellationVM.SelectedSymbol}"
                                          InputTransparent="True"/>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource Well}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding ConstellationVM.SelectedCategoryLabel}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="10.5"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.3"
                                       TextColor="{StaticResource InkTertiary}"/>
                                <Label Text="{Binding ConstellationVM.SelectedWhen}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="14"
                                       TextColor="{StaticResource Ink}"/>
                                <Label Text="{Binding ConstellationVM.SelectedDetail}"
                                       IsVisible="{Binding ConstellationVM.HasSelectedDetail}"
                                       FontFamily="{StaticResource FontSans}"
                                       FontSize="13"
                                       TextColor="{StaticResource InkSecondary}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="{loc:Translate Sky_Close}"
                           Padding="0,4"
                           FontFamily="{StaticResource FontSans}"
                           FontSize="12.5"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TealDeep}"
                           HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ConstellationVM.ClearSelectionCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </controls:FelovaBottomSheet.SheetContent>
        </controls:FelovaBottomSheet>

    </Grid>
</ContentPage>
