namespace Animal_Diary_App.Data.Services.Billing;

// TEMPLATE — copy this file to `BillingConfig.Secret.cs` (same folder) and paste the
// real RevenueCat public SDK keys. `BillingConfig.Secret.cs` is git-ignored so the
// keys never reach the repo. Without the copy the app still builds (key-less).
//
// The RevenueCat *public* SDK key (goog_… / appl_…) is publishable by design — it only
// permits what the store allows — but we keep it out of git per owner preference.
// The RevenueCat *secret* API key is server-side only and must never appear in the app.
public static partial class BillingConfig
{
    static partial void ApplySecrets()
    {
        AndroidSdkKey = "goog_XXXXXXXXXXXXXXXXXXXXXXXX";
        IosSdkKey = "appl_XXXXXXXXXXXXXXXXXXXXXXXX";
    }
}
