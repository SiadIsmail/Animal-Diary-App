namespace Animal_Diary_App.Data.Services.Attribution;

// TEMPLATE — copy this file to `MetaAdsConfig.Secret.cs` (same folder) and paste the real
// Meta App ID and Client Token. `MetaAdsConfig.Secret.cs` is git-ignored so they never
// reach the repo. Without the copy the app still builds and simply runs credential-less,
// which registers NullAdAttributionService and reports nothing.
//
// Both values are found at developers.facebook.com → your app: the App ID on the dashboard,
// the Client Token under Settings → Advanced → Security. Neither is a server secret — they
// ship inside the APK either way and can only identify the app to Meta. The Meta App SECRET
// is a different value entirely and must never appear in this project.
public static partial class MetaAdsConfig
{
    static partial void ApplySecrets()
    {
        AppId = "0000000000000000";
        ClientToken = "00000000000000000000000000000000";
    }
}
